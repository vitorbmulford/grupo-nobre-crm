{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "npm run prisma:generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\" \"*.json\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretypecheck": "npm run prisma:generate",
    "start": "PORT=${LOCAL_PORT:-3002} nest start --env-file ../.env",
    "prestart": "npm run prisma:generate",
    "start:dev": "PORT=${LOCAL_PORT:-3002} nest start --watch --env-file ../.env",
    "prestart:dev": "npm run prisma:generate",
    "start:debug": "PORT=${LOCAL_PORT:-3002} nest start --debug --watch --env-file ../.env",
    "prestart:debug": "npm run prisma:generate",
    "start:prod": "PORT=${LOCAL_PORT:-3002} node --env-file=../.env dist/main.js",
    "lint": "oxlint --type-aware --ignore-pattern 'src/generated/**' src/ test/",
    "test": "vitest run",
    "pretest": "npm run prisma:generate",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "pretest:e2e": "npm run prisma:generate",
    "prisma:generate": "DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.8",
    "helmet": "^8.3.0",
    "joi": "^18.3.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
