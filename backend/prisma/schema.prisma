generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum OpportunityStage {
  PRIMEIRO_CONTATO
  APRESENTACAO_ORCAMENTO
  FOLLOW_UP
  FORECAST
  FECHAMENTO
  PERDIDA
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  WHATSAPP
  OTHER
}

enum FollowUpAlertType {
  FOLLOW_UP_OVERDUE
  CONTACT_STALE
  PROPOSAL_EXPIRED
  CUSTOMER_EVENT_NEAR
}

enum FollowUpAlertStatus {
  OPEN
  RESOLVED
}

model Salesperson {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @unique @db.VarChar(160)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  opportunities Opportunity[]

  @@index([name])
}

model Opportunity {
  id                 String            @id @default(uuid()) @db.Uuid
  code               String            @unique @db.VarChar(32)
  companyName        String            @db.VarChar(240)
  contactName        String?           @db.VarChar(160)
  contactPhone       String?           @db.VarChar(30)
  contactEmail       String?           @db.VarChar(254)
  companyWebsite     String?           @db.VarChar(2048)
  companyLocation    String?           @db.VarChar(240)
  companyDescription String?           @db.VarChar(2000)
  stage              OpportunityStage  @default(PRIMEIRO_CONTATO)
  estimatedValue     Decimal?          @db.Decimal(14, 2)
  lastContactAt      DateTime?         @db.Date
  proposalValidUntil DateTime?         @db.Date
  customerEventDate  DateTime?         @db.Date
  nextFollowUpAt     DateTime?         @db.Timestamptz(3)
  lossReason         String?           @db.VarChar(1000)
  salespersonId      String?           @db.Uuid
  version            Int               @default(0)
  deletedAt          DateTime?         @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  salesperson        Salesperson?      @relation(fields: [salespersonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items              OpportunityItem[]
  stageTransitions   StageTransition[]
  activities         Activity[]
  followUpAlerts     FollowUpAlert[]

  @@index([companyName])
  @@index([stage])
  @@index([salespersonId])
  /// Business queries must require `deletedAt: null`; retain this for pipeline, activity, and automation reads.
  @@index([deletedAt])
  @@index([stage, deletedAt])
  @@index([salespersonId, deletedAt])
  @@index([createdAt])
}

model StageTransition {
  id            String            @id @default(uuid()) @db.Uuid
  opportunityId String            @db.Uuid
  fromStage     OpportunityStage?
  toStage       OpportunityStage
  reason        String?           @db.VarChar(1000)
  changedAt     DateTime          @default(now()) @db.Timestamptz(3)
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([opportunityId, changedAt, id])
  @@index([changedAt, id])
}

model Activity {
  id            String       @id @default(uuid()) @db.Uuid
  opportunityId String       @db.Uuid
  type          ActivityType
  description   String       @db.VarChar(2000)
  occurredAt    DateTime     @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([opportunityId, occurredAt(sort: Desc), id(sort: Asc)])
  @@index([occurredAt(sort: Desc), id(sort: Asc)])
}

model FollowUpAlert {
  id               String               @id @default(uuid()) @db.Uuid
  opportunityId    String               @db.Uuid
  type             FollowUpAlertType
  status           FollowUpAlertStatus  @default(OPEN)
  referenceAt      DateTime             @db.Timestamptz(3)
  acknowledgedAt   DateTime?            @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  resolvedAt       DateTime?            @db.Timestamptz(3)
  opportunity      Opportunity          @relation(fields: [opportunityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([opportunityId, createdAt(sort: Desc), id(sort: Asc)])
  @@index([status, createdAt(sort: Desc), id(sort: Asc)])
  @@index([type, status, createdAt(sort: Desc), id(sort: Asc)])
  @@index([createdAt(sort: Desc), id(sort: Asc)])
}

model OpportunityItem {
  id            String      @id @default(uuid()) @db.Uuid
  opportunityId String      @db.Uuid
  name          String      @db.VarChar(240)
  quantity      Int
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([opportunityId])
  @@index([name])
}
