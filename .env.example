# Local development values only. Replace these before using a shared environment.
NODE_ENV=production
PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost,http://localhost:3000
FOLLOW_UP_EVALUATION_INTERVAL_MS=900000
FOLLOW_UP_STALE_CONTACT_DAYS=7
FOLLOW_UP_CUSTOMER_EVENT_WINDOW_DAYS=7

# URL used when running the Nest API directly on the host.
DATABASE_URL=postgresql://grupo_nobre:local_dev_password@localhost:5432/grupo_nobre_crm?schema=public

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=grupo_nobre_crm
POSTGRES_USER=grupo_nobre
POSTGRES_PASSWORD=local_dev_password
# HTTP port published by Nginx. The default provides http://localhost.
HTTP_HOST_PORT=80

# Browser-visible API path baked into the Docker frontend build.
NEXT_PUBLIC_API_URL=/api
