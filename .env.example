# Local development values only. Replace these before using a shared environment.
NODE_ENV=production
PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# URL used when running the Nest API directly on the host.
DATABASE_URL=postgresql://grupo_nobre:local_dev_password@localhost:5436/grupo_nobre_crm?schema=public

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=grupo_nobre_crm
POSTGRES_USER=grupo_nobre
POSTGRES_PASSWORD=local_dev_password
POSTGRES_HOST_PORT=5436

# Host port published by the backend container.
BACKEND_HOST_PORT=3001
